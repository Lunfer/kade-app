# Copy this to .env.development (emulator) or .env.local (your own overrides).
# Expo loads EXPO_PUBLIC_* vars natively -- no extra package needed.

# Leave EXPO_PUBLIC_API_URL unset to auto-detect the LAN IP of the machine
# running `expo start`, when testing on a physical device via Expo Go.

# Android emulator needs the special alias below, since 10.0.2.2 is the
# emulator's route to the host machine's localhost:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Deployed backend (used automatically for anything that isn't __DEV__):
# EXPO_PUBLIC_API_URL=https://kade-backend-xxxxx.run.app

# Must match the deployed backend's API_SECRET once it's set there --
# only needed alongside EXPO_PUBLIC_API_URL pointing at a deployed backend.
# EXPO_PUBLIC_API_SECRET=

# In practice: put the two lines above into a file named .env.local at
# the project root (NOT .env.production without .local -- .gitignore
# only excludes .env*.local, so a plain .env or .env.production would
# commit your real secret). .env.local loads in every mode, dev and
# release both, so this makes normal day-to-day testing
# (npx expo run:android / expo start) talk to the deployed backend too,
# not just release builds -- your laptop no longer needs the backend
# running for the phone to work. This is the same tradeoff either way
# on Anthropic cost (same key, same billable call, local or deployed);
# it just means GCP is now in the loop for everyday testing too (still
# $0/month at this scale -- see README.md's cost notes). To go back to
# local-only testing later, just rename .env.local out of the way --
# the LAN auto-detection in src/config/env.ts is still there underneath
# and takes back over the moment EXPO_PUBLIC_API_URL isn't set. See
# README.md's "Deploying to Cloud Run" section for the exact commands.

EXPO_PUBLIC_API_PORT=8000
