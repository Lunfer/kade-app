# Copy this to .env.development (emulator) or .env.local (your own overrides).
# Expo loads EXPO_PUBLIC_* vars natively -- no extra package needed.

# Leave EXPO_PUBLIC_API_URL unset to auto-detect the LAN IP of the machine
# running `expo start`, when testing on a physical device via Expo Go.

# Android emulator needs the special alias below, since 10.0.2.2 is the
# emulator's route to the host machine's localhost:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Deployed backend (used automatically for anything that isn't __DEV__):
# EXPO_PUBLIC_API_URL=https://kade-backend-xxxxx.run.app

# Must match the deployed backend's API_SECRET once it's set there --
# only needed alongside EXPO_PUBLIC_API_URL pointing at a deployed backend.
# EXPO_PUBLIC_API_SECRET=

# In practice: put the two lines above into a file named
# .env.production.local at the project root (NOT .env.production without
# .local -- .gitignore only excludes .env*.local, so a plain
# .env.production would commit your real secret). Expo only loads that
# file for release/production builds, so your everyday dev-client
# workflow (npx expo run:android / expo start) is unaffected -- see
# README.md's "Deploying to Cloud Run" section for the exact commands.

EXPO_PUBLIC_API_PORT=8000
