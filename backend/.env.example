ANTHROPIC_API_KEY=sk-ant-...
# Optional -- override if the default model id is retired.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional locally, should be set before deploying publicly. Shared secret
# the frontend must send as the X-API-Secret header (see main.py
# verify_api_secret). Empty = no check enforced. Generate with:
#   openssl rand -hex 32
# API_SECRET=
